msgstr "Текст зі Spotify: {song}."

#, python-brace-format
msgid "Lyrics text size {size}."
msgstr "Розмір тексту {size}."

#, python-brace-format
msgid "No artists found for {query}."
msgstr "Виконавців за запитом {query} не знайдено."

