msgstr "&Вихід"

msgid "Find"
msgstr "Знайти"

msgid "Find a song first, then open it in Spotify."
msgstr "Спочатку знайдіть пісню, потім відкрийте її в Spotify."

msgid "Find in Spotify (Ctrl+S)"
msgstr "Знайти в Spotify (Ctrl+S)"

