msgid "GitHub answered with error {code}. Try again later."
msgstr "GitHub відповів помилкою {code}. Спробуйте пізніше."

msgid "Instrumental, no lyrics."
msgstr "Інструментал, без слів."

#, python-brace-format
msgid "Language changed to {name}."
msgstr "Мову змінено: {name}."

#, python-brace-format
msgid "Looking for songs with lyrics by {artist}..."
msgstr "Шукаю пісні з текстами виконавця {artist}..."

msgid "Lyrico can't control the player on this computer."
msgstr "Lyrico не може керувати плеєром на цьому комп'ютері."

msgid "Lyrico can't read what's playing on this computer."
msgstr "Lyrico не може дізнатися, що грає на цьому комп'ютері."

#, python-brace-format
msgid ""
"Lyrico can't replace its own file in {folder}. Move Lyrico.exe to a folder you can write to, such"
" as Documents."
msgstr ""
"Lyrico не може замінити власний файл у теці {folder}. Перемістіть Lyrico.exe до теки, у яку можна"
" записувати, наприклад до Документів."

#, python-brace-format
msgid "Lyrico {new} is available. Use Help, Check for updates to install it."
msgstr "Доступна версія Lyrico {new}. Щоб установити, виберіть Довідка, Перевірити оновлення."

#, python-brace-format
msgid ""
"Lyrico {new} is available. You have {current}.\n"
"\n"
"Download and install it now? Lyrico will restart."
msgstr ""
"Доступна версія Lyrico {new}. У вас {current}.\n"
"\n"
"Завантажити й установити зараз? Lyrico перезапуститься."

#, python-brace-format
msgid ""
"Lyrico {version}\n"
"\n"
"Find song lyrics fast.\n"
"Lyrics come from LRCLIB and lyrics.ovh, artists and their songs from iTunes."
msgstr ""
"Lyrico {version}\n"
"\n"
"Швидкий пошук текстів пісень.\n"
"Тексти беруться з LRCLIB і lyrics.ovh, виконавці та їхні пісні з iTunes."

