msgstr "Пісень із текстами для {artist} не знайдено."

msgid "No updates"
msgstr "Оновлень немає"

msgid "Nothing is playing right now."
msgstr "Зараз нічого не грає."

#, python-brace-format
msgid "Now playing: {song}."
msgstr "Зараз грає: {song}."

#, python-brace-format
msgid "Opening Spotify search for {query}."
msgstr "Відкриваю пошук {query} у Spotify."

msgid "P&revious song\tAlt+Left"
msgstr "&Попередня пісня\tAlt+Left"

msgid "Play or p&ause\tAlt+Down"
msgstr "&Відтворення або пауза\tAlt+Down"

#, python-brace-format
msgid "Press Enter to see songs by {artist}."
msgstr "Натисніть Enter, щоб побачити пісні виконавця {artist}."

msgid "Search &by:"
msgstr "Шукати за (Alt+B):"

#, python-brace-format
msgid "Searching for {query}..."
msgstr "Шукаю {query}..."

msgid "Searching..."
msgstr "Шукаю..."

msgid "Song, artist or both"
msgstr "Пісня, виконавець або обидва"

msgid "Songs"
msgstr "Пісні"

msgid "Spotify"
msgstr "Spotify"

msgid "Spotify lyrics arrived."
msgstr "Надійшов текст зі Spotify."

msgid "Spotify sync (Ctrl+Shift+P)"
msgstr "Синхронізація зі Spotify (Ctrl+Shift+P)"

msgid "Spotify sync is off."
msgstr "Синхронізацію зі Spotify вимкнено."

msgid "Spotify sync is on. Lyrics follow the song playing in Spotify."
msgstr "Синхронізацію зі Spotify увімкнено. Текст змінюватиметься разом із піснею в Spotify."

msgid "Spotify sync off."
msgstr "Синхронізацію зі Spotify вимкнено."

msgid "Spotify sync on."
msgstr "Синхронізацію зі Spotify увімкнено."

msgid "Spotify sync: waiting for Spotify to play a song."
msgstr "Синхронізація зі Spotify: чекаю, доки Spotify заграє пісню."

msgid "The download is damaged (checksum mismatch)."
msgstr "Завантажений файл пошкоджений (контрольна сума не збігається)."

msgid "The lyrics server sent a bad response. Try again in a moment."
msgstr "Сервер текстів надіслав хибну відповідь. Спробуйте ще раз за мить."

msgid "This release has no Lyrico.exe."
msgstr "У цьому випуску немає Lyrico.exe."

msgid "This release has no checksum, so it can't be checked safely."
msgstr "У цьому випуску немає контрольної суми, тож його не можна безпечно перевірити."

msgid "Type a song and press Enter."
msgstr "Введіть пісню й натисніть Enter."

msgid "Update"
msgstr "Оновлення"

msgid "Update available"
msgstr "Є оновлення"

#, python-brace-format
msgid "Update check failed: {error}"
msgstr "Не вдалося перевірити оновлення: {error}"

#, python-brace-format
msgid "Update failed: {error}"
msgstr "Не вдалося оновити: {error}"

msgid "Updates work only in Lyrico.exe, not when running from source."
msgstr "Оновлення працюють лише в Lyrico.exe, а не під час запуску з вихідного коду."

#, python-brace-format
